#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/yamlease'

if ARGV.length != 1
  warn 'Usage: ye RELEASE_DEFINITION_FILE'
  exit 2
end

begin
  pipeline = Yamlease::ReleasePipeline.new(ARGV.first)
  puts pipeline.to_yaml
  # The warnings are already in the YAML header; repeat them only if that is going to a file.
  pipeline.warnings.each { |message| warn "TODO: #{message}" } unless $stdout.tty?
rescue Yamlease::Error, SystemCallError, Psych::SyntaxError => e
  warn "ye: #{e.message}"
  exit 1
end
